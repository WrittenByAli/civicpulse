# Copy this file to .env and fill in your values
# .env is git-ignored and must NEVER be committed

# Triage provider: rules | simulated | llm | ollama
TRIAGE_PROVIDER=rules

# JWT secret for authentication — generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production

# Email (Resend — https://resend.com, free tier: 100 emails/day)
# Leave blank to skip sending emails and log OTPs to stdout (dev mode)
RESEND_API_KEY=
FROM_EMAIL=CivicPulse <noreply@civicpulse.app>

# Role access control — who may self-register as an operator
# Comma-separated email domains:  OPERATOR_DOMAINS=municipality.gov.pk,civicpulse.app
# Comma-separated exact emails:   OPERATOR_EMAILS=admin@gmail.com,ops@example.com
# Leave both empty to disable operator self-registration entirely.
OPERATOR_DOMAINS=
OPERATOR_EMAILS=

# Required only when TRIAGE_PROVIDER=llm
GROQ_API_KEY=

# Required only when TRIAGE_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:1.5b
