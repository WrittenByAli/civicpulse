# Database
POSTGRES_USER=civicpulse
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=civicpulse
DATABASE_URL=postgresql://civicpulse:CHANGE_ME@postgres:5432/civicpulse

# Redis
REDIS_URL=redis://redis:6379/0

# AI Triage — choose: llm | ollama | rules | simulated
TRIAGE_PROVIDER=llm

# LLM API key (Groq — get free key at console.groq.com)
# NEVER commit a real key — this file is safe because values are empty
GROQ_API_KEY=

# Rate limiting
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Ollama (only needed when TRIAGE_PROVIDER=ollama)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Image tag (used by compose.prod.yaml)
IMAGE_TAG=latest
